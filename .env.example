# Regal Meeting — environment variables
# Copy secrets from ~/Documents/CLOUDFLARE 2.md via: npm run sync:cloudflare-credentials

# Shared Regal Mail + Meeting Supabase (production)
# Auth redirect URLs: see docs/SUPABASE_AUTH_REDIRECTS.md
VITE_SUPABASE_PROJECT_ID=xexnwcmqnelgzuqhkvtx
VITE_SUPABASE_URL=https://xexnwcmqnelgzuqhkvtx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy Meeting-only project (optional / historical)
# VITE_SUPABASE_PROJECT_ID=ytbilvvrqokjqvzbbtpd
# VITE_SUPABASE_URL=https://ytbilvvrqokjqvzbbtpd.supabase.co

# Regal Mail SSO — same project when unified
VITE_REGAL_MAIL_SUPABASE_URL=https://xexnwcmqnelgzuqhkvtx.supabase.co
VITE_REGAL_MAIL_SUPABASE_ANON_KEY=

# Cloudflare R2 public CDN
VITE_R2_PUBLIC_URL=https://pub-6a39992a6616496caf0575e44acb32aa.r2.dev

# Cloudflare Pages production URL
VITE_SITE_URL=https://meet.regalmesh.com
MEET_DOMAIN=meet.regalmesh.com
PAGES_PROJECT=regal-meeting
REGAL_ZONE=regalmesh.com
CLOUDFLARE_ZONE_ID=ea22f581b752a0fb1ffd03a2a36b3a5c

# Regal Mail Auth redirect URLs — add in Supabase → Auth → URL Configuration:
#   http://localhost:8080/auth?provider=regal-mail
#   https://meet.regalmesh.com/auth?provider=regal-mail
#   regalmeet://auth-callback
#   regalmeet://auth-callback?provider=regal-mail
#
# Production TURN (strongly recommended for reliable calls behind NAT/firewall)
# Comma-separated URLs, e.g. turn:turn.example.com:3478,turns:turn.example.com:443?transport=tcp
# VITE_TURN_URLS=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# CLOUDFLARE_REALTIME_APP_SECRET=
# CLOUDFLARE_ACCOUNT_ID=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_S3_ENDPOINT=
# R2_BUCKET_NAME=regal-meeting-files
